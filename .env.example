# Application image (GHCR)
IMAGE_NAME=ghcr.io/radixartem/gastromenuparserapi
VERSION=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=gastro_menu
POSTGRES_DATA_DIR=/srv/gastro/postgres

# Explicit application connection string. Do not commit real credentials.
DB_CONNECTION_STRING=Host=postgres;Database=gastro_menu;Username=postgres;Password=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Apply EF Core migrations on container startup.
APPLY_MIGRATIONS=true

# Secret required by POST /api/menu/import
IMPORT_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Backup / Hetzner Object Storage
OBJ_ACCESS_KEY=CHANGE_ME
OBJ_SECRET_KEY=CHANGE_ME
OBJ_ENDPOINT=https://fsn1.your-objectstorage.com
OBJ_BUCKET=gastro-api-backups
OBJ_REGION=fsn1
BACKUP_RETENTION_DAYS=14
